# ============================================================
# Loop-Based Multi-Agent System — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env with real credentials to version control.
# ============================================================

# Application environment: development | production
APP_ENV=development

# SQLite database path (relative to backend directory)
DATABASE_URL=sqlite:///./app.db

# ============================================================
# PRIMARY LLM PROVIDER
# Used for all agent executions (Requirement, Planner, Coder,
# Tester, Reviewer, Debugger, Evaluation, Documentation)
# ============================================================

# Provider name: google | nvidia | openai | groq | anthropic
PRIMARY_LLM_PROVIDER=google

# Model identifier for the primary provider
PRIMARY_LLM_MODEL=gemini-flash-lite-latest

# API key for the primary provider
PRIMARY_LLM_API_KEY=your_primary_api_key_here

# ============================================================
# FALLBACK LLM PROVIDER
# Used when the primary provider fails or times out
# ============================================================

FALLBACK_LLM_PROVIDER=google
FALLBACK_LLM_MODEL=gemini-3.1-flash-lite
FALLBACK_LLM_API_KEY=your_fallback_api_key_here

# ============================================================
# WORKFLOW LIMITS
# ============================================================

# Maximum development iterations per version (test→review→debug loop)
# Recommended: 3-5 for demos, 5-10 for production
MAX_ITERATIONS=5

# Maximum number of user revision cycles per project
MAX_USER_REVISIONS=3

# ============================================================
# CODE EXECUTION SANDBOX
# ============================================================

# Execution mode: docker | subprocess | mock
SANDBOX_MODE=docker

# Timeout in seconds for code execution in the sandbox
EXECUTION_TIMEOUT=30

# Docker image to use for sandboxed execution
# SANDBOX_DOCKER_IMAGE=python:3.11-slim
